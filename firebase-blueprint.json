        "directorNameAr": { "type": "string" },
        "directorNameBs": { "type": "string" },
        "directorTitleAr": { "type": "string" },
        "directorTitleBs": { "type": "string" },
        "sarajevoOfficeAddressBs": { "type": "string" },
        "contactEmail": { "type": "string" },
        "adminPin": { "type": "string" },
        "customLogoUrl": { "type": "string" }
      }
    },
    "landing_config": {
      "title": "Landing Configuration",
      "description": "Dynamic editable content for the landing page and hero section",
      "fields": {
        "heroTitleAr": { "type": "string" },
        "heroTitleBs": { "type": "string" },
        "heroSubtitleAr": { "type": "string" },
        "heroSubtitleBs": { "type": "string" },
        "heroBadgeAr": { "type": "string" },
        "heroBadgeBs": { "type": "string" },
        "quranVerseAr": { "type": "string" },
        "quranVerseBs": { "type": "string" },
        "quranCitationAr": { "type": "string" },
        "quranCitationBs": { "type": "string" },
        "stats": { "type": "array" },
        "contactInfo": { "type": "object" },
        "heroImageUrl": { "type": "string" }
      }
    },
    "documents": {
      "title": "Official Documents & Letters",
      "description": "Government letters, mandate documents, and administrative paperwork",
      "fields": {
        "title": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "sender": { "type": "string" },
        "recipient": { "type": "string" },
        "contentAr": { "type": "string" },
        "contentBs": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "invoices": {
      "title": "Invoices & Finance",
      "description": "Expense invoices, currency conversions, and financial statements",
      "fields": {
