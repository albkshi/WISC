      "fields": {
        "nameAr": { "type": "string" },
        "nameBs": { "type": "string" },
        "cityAr": { "type": "string" },
        "cityBs": { "type": "string" },
        "yearBuilt": { "type": "string" },
        "builderAr": { "type": "string" },
        "builderBs": { "type": "string" },
        "architectAr": { "type": "string" },
        "architectBs": { "type": "string" },
        "tagAr": { "type": "string" },
        "tagBs": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionBs": { "type": "string" },
        "historicalSignificanceAr": { "type": "string" },
        "historicalSignificanceBs": { "type": "string" },
        "imageUrl": { "type": "string" },
        "featuresAr": { "type": "array" },
        "featuresBs": { "type": "array" }
      }
    },
    "gallery_images": {
      "title": "Media & Gallery Images",
      "description": "Uploaded pictures, banners, mosque photos and media assets stored in Firebase",
      "fields": {
        "titleAr": { "type": "string" },
        "titleBs": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "descriptionBs": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "sizeKb": { "type": "number" },
        "isBuiltIn": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "System settings, admin PIN, official logo and styling"
    },
    "/landing_config/{configId}": {
      "schema": "landing_config",
      "description": "Landing page hero title, description, and hero banner image"
    },
    "/documents/{documentId}": {
      "schema": "documents",
      "description": "Official mandate letters and governmental correspondence"
    },
    "/invoices/{invoiceId}": {
      "schema": "invoices",
      "description": "Financial accounting records and expense invoices"
    },
    "/activities/{activityId}": {
      "schema": "activities",
      "description": "Regional news, diplomatic meetings and humanitarian activities"
    },
    "/mosques/{mosqueId}": {
      "schema": "mosques",
      "description": "Historic Bosnian mosques catalogue with linked images"
    },
    "/gallery_images/{imageId}": {
      "schema": "gallery_images",
      "description": "Media library of uploaded images and assets in Firebase"
    }
  }
}
