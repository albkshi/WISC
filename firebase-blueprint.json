        "date": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "activities": {
      "title": "Activities & News",
      "description": "Humanitarian and cultural activity news",
      "fields": {
        "titleAr": { "type": "string" },
        "titleBs": { "type": "string" },
        "summaryAr": { "type": "string" },
        "summaryBs": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "mosques": {
      "title": "Historic Bosnian Mosques",
